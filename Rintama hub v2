local Spectating = false
local SpectateIndex = 1
local TargetSpectatePlayer = nil

local function GetSpectateTargets()
	local targets = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			table.insert(targets, p)
		end
	end
	return targets
end

local function UpdateSpectate()
	local targets = GetSpectateTargets()
	if #targets == 0 then
		SpectateName.Text = "No Players"
		TargetSpectatePlayer = nil
		if Spectating and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			workspace.CurrentCamera.CameraSubject = LocalPlayer.Character.Humanoid
		end
		return
	end

	if SpectateIndex > #targets then SpectateIndex = 1 end
	if SpectateIndex < 1 then SpectateIndex = #targets end

	TargetSpectatePlayer = targets[SpectateIndex]
	SpectateName.Text = TargetSpectatePlayer.Name

	if Spectating and TargetSpectatePlayer.Character and TargetSpectatePlayer.Character:FindFirstChild("Humanoid") then
		workspace.CurrentCamera.CameraSubject = TargetSpectatePlayer.Character.Humanoid
	end
end

PrevBtn.MouseButton1Click:Connect(function()
	SpectateIndex = SpectateIndex - 1
	UpdateSpectate()
end)

NextBtn.MouseButton1Click:Connect(function()
	SpectateIndex = SpectateIndex + 1
	UpdateSpectate()
end)

ToggleSpectateBtn.MouseButton1Click:Connect(function()
	Spectating = not Spectating
	if Spectating then
		ToggleSpectateBtn.Text = "SPECTATE: ON"
		ToggleSpectateBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
		TweenService:Create(ToggleSpectateBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(50, 70, 50)}):Play()
		UpdateSpectate()
	else
		ToggleSpectateBtn.Text = "SPECTATE: OFF"
		ToggleSpectateBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
		TweenService:Create(ToggleSpectateBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
		TargetSpectatePlayer = nil
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			workspace.CurrentCamera.CameraSubject = LocalPlayer.Character.Humanoid
		end
	end
end)

TeleportBtn.MouseButton1Click:Connect(function()
	if TargetSpectatePlayer and TargetSpectatePlayer.Character and TargetSpectatePlayer.Character:FindFirstChild("HumanoidRootPart") then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			TweenService:Create(TeleportBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(100, 100, 120)}):Play()
			task.wait(0.1)
			TweenService:Create(TeleportBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
			
			LocalPlayer.Character.HumanoidRootPart.CFrame = TargetSpectatePlayer.Character.HumanoidRootPart.CFrame
		end
	end
end)

task.spawn(function()
	while ScreenGui.Parent do
		task.wait(0.2)
		if Spectating then
			if TargetSpectatePlayer and TargetSpectatePlayer.Parent == Players then
				if TargetSpectatePlayer.Character and TargetSpectatePlayer.Character:FindFirstChild("Humanoid") then
					if workspace.CurrentCamera.CameraSubject ~= TargetSpectatePlayer.Character.Humanoid then
						workspace.CurrentCamera.CameraSubject = TargetSpectatePlayer.Character.Humanoid
					end
				end
			else
				UpdateSpectate()
			end
		end
	end
end)

