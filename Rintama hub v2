local function ToggleCarryAll(state)
    if state then
        -- KHI BẬT (Trạng thái true: Bắt tất cả)
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if player ~= game:GetService("Players").LocalPlayer and player.Character then
                local args = {
                    {
                        ["\194\162"] = {
                            player.Character,
                            true
                        },

                        ["\194\145"] = {
                            game:GetService("ReplicatedStorage")
                                :WaitForChild("Assets")
                                :WaitForChild("Sounds")
                                :WaitForChild("Combat")
                                :WaitForChild("Swing")
                                :WaitForChild("Light")
                                :WaitForChild("0013"),

                            {
                                ParentFolder = game:GetService("ReplicatedStorage")
                                    :WaitForChild("Assets")
                                    :WaitForChild("Sounds")
                                    :WaitForChild("Combat")
                                    :WaitForChild("Swing")
                                    :WaitForChild("Light"),

                                RollOffMode = Enum.RollOffMode.Inverse,
                                Looped = false,
                                MinDistance = 5,
                                MaxDistance = 50,
                                Name = "",
                                Volume = 0.5,
                                RandomizePlaybackSpeed = true,
                                PlayOnRemove = true
                            }
                        }
                    },
                    {}
                }

                game:GetService("ReplicatedStorage")
                    :WaitForChild("RedEvent")
                    :FireServer(unpack(args))
            end
        end
    else
        -- KHI TẮT (Trạng thái false: Nhả tất cả)
        for _, player in pairs(game:GetService("Players"):GetPlayers()) do
            if player.Character then
                local args = {
                    {
                        ["\194\162"] = {
                            player.Character, -- Đổi từ "ruitenki" thành nhân vật của từng người chơi trong server
                            false
                        },
                        ["\194\145"] = {
                            game:GetService("ReplicatedStorage"):WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013"),
                            {
                                ParentFolder = game:GetService("ReplicatedStorage"):WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"),
                                RollOffMode = Enum.RollOffMode.Inverse,
                                Looped = false,
                                MinDistance = 5,
                                MaxDistance = 50,
                                Name = "",
                                Volume = 0.5,
                                RandomizePlaybackSpeed = true,
                                PlayOnRemove = true
                            }
                        }
                    },
                    {}
                }
                
                game:GetService("ReplicatedStorage"):WaitForChild("RedEvent"):FireServer(unpack(args))
            end
        end
    end
end
