local function GetPlayerFromString(str)
	if not str or str == "" then return nil end
	str = string.lower(str)
	for _, player in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(player.Name), str) or string.find(string.lower(player.DisplayName), str) then
			return player
		end
	end
	return nil
end

local CurrentTarget = nil

ToggleCarryTargetBtn.MouseButton1Click:Connect(function()
	getgenv().CarryTargetToggled = not getgenv().CarryTargetToggled

	if getgenv().CarryTargetToggled then
		CurrentTarget = GetPlayerFromString(TargetBox.Text)
		if not CurrentTarget then
			TargetBox.Text = "Not found!"
			task.wait(1)
			TargetBox.Text = ""
			getgenv().CarryTargetToggled = false
			return
		end

		TargetBox.Text = CurrentTarget.Name
		ToggleCarryTargetBtn.Text = "CARRY TARGET: ON"
		ToggleCarryTargetBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
		TweenService:Create(ToggleCarryTargetBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(50, 70, 50)}):Play()

		task.spawn(function()
			while getgenv().CarryTargetToggled and CurrentTarget do
				if CurrentTarget.Character and CurrentTarget ~= LocalPlayer then
					pcall(function()
						local soundAsset = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013")
						local args = { { ["\194\162"] = { CurrentTarget.Character, true }, ["\194\145"] = { soundAsset, { ParentFolder = soundAsset.Parent, RollOffMode = Enum.RollOffMode.Inverse, Looped = false, MinDistance = 5000, MaxDistance = 5000, Name = "", Volume = 0.5, RandomizePlaybackSpeed = true, PlayOnRemove = true } } }, {} }
						ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
					end)
				end
				task.wait(0.05)
			end
		end)
	else
		ToggleCarryTargetBtn.Text = "CARRY TARGET: OFF"
		ToggleCarryTargetBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
		TweenService:Create(ToggleCarryTargetBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()

		if CurrentTarget and CurrentTarget.Character then
			pcall(function()
				local soundAsset = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013")
				local args = { { ["\194\162"] = { CurrentTarget.Character, false }, ["\194\145"] = { soundAsset, { ParentFolder = soundAsset.Parent, RollOffMode = Enum.RollOffMode.Inverse, Looped = false, MinDistance = 5000, MaxDistance = 5000, Name = "", Volume = 0.5, RandomizePlaybackSpeed = true, PlayOnRemove = true } } }, {} }
				ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
			end)
		end
		CurrentTarget = nil
	end
end)

