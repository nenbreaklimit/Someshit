local function executeFarmScript()
	pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/nenbreaklimit/Someshit/refs/heads/main/Rintamahigh"))()
	end)
end

ToggleFarmBtn.MouseButton1Click:Connect(function()
	getgenv().AutoFarmDelivery = not getgenv().AutoFarmDelivery
	if getgenv().AutoFarmDelivery then
		ToggleFarmBtn.Text = "AUTO FARM: ON"
		ToggleFarmBtn.BackgroundColor3 = Color3.fromRGB(55, 170, 85)
		task.spawn(executeFarmScript)
	else
		ToggleFarmBtn.Text = "AUTO FARM: OFF"
		ToggleFarmBtn.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
	end
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1.5)
	if getgenv().AutoFarmDelivery then
		task.spawn(executeFarmScript)
	end
end)

local ToggleCarryAllBtn = Instance.new("TextButton")
ToggleCarryAllBtn.Parent = TrollPage
ToggleCarryAllBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
ToggleCarryAllBtn.Size = UDim2.new(1, 0, 0, 35)
ToggleCarryAllBtn.Font = Enum.Font.GothamBold
ToggleCarryAllBtn.Text = "CARRY ALL: OFF"
ToggleCarryAllBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
ToggleCarryAllBtn.TextSize = 14
Instance.new("UICorner", ToggleCarryAllBtn).CornerRadius = UDim.new(0, 8)

ToggleCarryAllBtn.MouseButton1Click:Connect(function()
	getgenv().GrabAllToggled = not getgenv().GrabAllToggled
	
	if getgenv().GrabAllToggled then
		ToggleCarryAllBtn.Text = "CARRY ALL: ON"
		ToggleCarryAllBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
		TweenService:Create(ToggleCarryAllBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(50, 70, 50)}):Play()
		
		task.spawn(function()
			while getgenv().GrabAllToggled do
				for _, player in ipairs(Players:GetPlayers()) do
					if not getgenv().GrabAllToggled then break end
					if player ~= LocalPlayer and player.Character then
						pcall(function()
							local soundAsset = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013")
							local args = {
								{
									["\194\162"] = { player.Character, true },
									["\194\145"] = {
										soundAsset,
										{
											ParentFolder = soundAsset.Parent,
											RollOffMode = Enum.RollOffMode.Inverse,
											Looped = false,
											MinDistance = 5000,
											MaxDistance = 5000,
											Name = "",
											Volume = 0.5,
											RandomizePlaybackSpeed = true,
											PlayOnRemove = true
										}
									}
								},
								{}
							}
							ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
						end)
						task.wait(0.05)
					end
				end
				task.wait(0.1)
			end
		end)
	else
		ToggleCarryAllBtn.Text = "CARRY ALL: OFF"
		ToggleCarryAllBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
		TweenService:Create(ToggleCarryAllBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
		
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				pcall(function()
					local soundAsset = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013")
					local args = {
						{
							["\194\162"] = { player.Character, false },
							["\194\145"] = {
								soundAsset,
								{
									ParentFolder = soundAsset.Parent,
									RollOffMode = Enum.RollOffMode.Inverse,
									Looped = false,
									MinDistance = 5000,
									MaxDistance = 5000,
									Name = "",
									Volume = 0.5,
									RandomizePlaybackSpeed = true,
									PlayOnRemove = true
								}
							}
						},
						{}
					}
					ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
				end)
			end
		end
	end
end)

