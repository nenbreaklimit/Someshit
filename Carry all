local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 1. TẠO UI (GIAO DIỆN)
local ScreenGui = Instance.new("ScreenGui")
local TextButton = Instance.new("TextButton")

if gethui then
	ScreenGui.Parent = gethui()
elseif syn and syn.protect_gui then
	syn.protect_gui(ScreenGui)
	ScreenGui.Parent = game:GetService("CoreGui")
else
	ScreenGui.Parent = game:GetService("CoreGui")
end

-- 2. THIẾT KẾ NÚT
TextButton.Parent = ScreenGui
TextButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
TextButton.Position = UDim2.new(0.5, -75, 0.2, 0)
TextButton.Size = UDim2.new(0, 150, 0, 40)
TextButton.Font = Enum.Font.GothamBold
TextButton.Text = "CARRY ALL: OFF"
TextButton.TextColor3 = Color3.fromRGB(255, 255, 255)
TextButton.TextSize = 14
TextButton.Active = true
TextButton.Draggable = true

local isToggled = false

-- 3. LOGIC KHI BẤM NÚT (ÁP DỤNG LÊN MỌI NGƯỜI CHƠI)
TextButton.MouseButton1Click:Connect(function()
	isToggled = not isToggled
	
	if isToggled then
		-- TRẠNG THÁI: BẬT
		TextButton.Text = "CARRY ALL: ON"
		TextButton.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
		
		-- Quét tất cả người chơi trong server
		for _, player in ipairs(Players:GetPlayers()) do
			-- Kiểm tra: Không phải bản thân mình VÀ họ đang sống (có Character)
			if player ~= LocalPlayer and player.Character then
				local args = {
					{
						["\194\162"] = {
							player.Character,
							true
						},
						["\194\145"] = {
							ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013"),
							{
								ParentFolder = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"),
								RollOffMode = Enum.RollOffMode.Inverse,
								Looped = false,
								MinDistance = 5000,
								MaxDistance = 5000,
								Name = "",
								Volume = 0.5,
								RandomizePlaybackSpeed = true,
								PlayOnRemove = true
							}
						}
					},
					{}
				}
				ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
				task.wait(0.05) -- Nghỉ một chút để không bị lag hoặc văng game do spam server
			end
		end
		
	else
		-- TRẠNG THÁI: TẮT
		TextButton.Text = "CARRY ALL: OFF"
		TextButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
		
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local args = {
					{
						["\194\162"] = {
							player.Character,
							false
						},
						["\194\145"] = {
							ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013"),
							{
								ParentFolder = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"),
								RollOffMode = Enum.RollOffMode.Inverse,
								Looped = false,
								MinDistance = 5000,
								MaxDistance = 5000,
								Name = "",
								Volume = 0.5,
								RandomizePlaybackSpeed = true,
								PlayOnRemove = true
							}
						}
					},
					{}
				}
				ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
				task.wait(0.05)
			end
		end
	end
end)
