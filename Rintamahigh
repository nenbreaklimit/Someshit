--==================================================
-- UTILITIES
--==================================================
local function getCharacterData()
    local char = player.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    return char, root, hum
end

local function getRoot()
    local _, root = getCharacterData()
    if not root and player.Character then
        root = player.Character:WaitForChild("HumanoidRootPart", 5)
    end
    return root
end

local function teleportTo(targetCFrame)
    pcall(function()
        local root = getRoot()
        if root then
            -- Tắt velocity trước khi dịch chuyển để tránh bị văng
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = targetCFrame
        end
    end)
end

--==================================================
-- KHÔNG BAO GIỜ RỚT (HOVER LOCK)
--==================================================
local bodyVel

local function applyFloat()
    local _, root, hum = getCharacterData()
    if not root then return end

    if hum then
        hum.PlatformStand = true
    end

    if not root:FindFirstChild("FarmBodyVelocity") then
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.Name = "FarmBodyVelocity"
        bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVel.Velocity = Vector3.zero
        bodyVel.Parent = root
    end
end

local floatConnection
floatConnection = RunService.Heartbeat:Connect(function()
    if not getgenv().AutoFarmDelivery then
        if bodyVel then bodyVel:Destroy() end
        local _, _, hum = getCharacterData()
        if hum then hum.PlatformStand = false end
        if floatConnection then floatConnection:Disconnect() end
        return
    end

    pcall(function()
        applyFloat()
        local _, root = getCharacterData()
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end)

--==================================================
-- CORE LOGIC
--==================================================
local function takeQuest()
    pcall(function()
        local args = { { [";"] = Config.QuestName }, {} }
        ReplicatedStorage:WaitForChild("RedEvent", 5):FireServer(unpack(args))
    end)
end

local function findDeliveryNPC()
    local foundNpc, foundRoot = nil, nil
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("DeliveryPulse", true) then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if root then
                    foundNpc = obj
                    foundRoot = root
                    break
                end
            end
        end
    end)
    return foundNpc, foundRoot
end

local function completeDelivery(npcName)
    pcall(function()
        local args = { { ["<"] = npcName }, {} }
        ReplicatedStorage:WaitForChild("RedEvent", 5):FireServer(unpack(args))
    end)
end

--==================================================
-- MAIN LOOP (ĐÃ FIX LẠI LOGIC CHỐNG HỤT)
--==================================================
task.spawn(function()
    while getgenv().AutoFarmDelivery do
        
        -- BƯỚC 1: ĐI TỚI CHỖ NHẬN QUEST
        teleportTo(Config.StartPos)
        task.wait(Config.TeleportDelay) -- Chờ 1 giây để Server load xong vị trí của bạn
        
        if not getgenv().AutoFarmDelivery then break end
        
        -- BƯỚC 2: GỬI LỆNH NHẬN QUEST
        takeQuest()
        task.wait(Config.ActionDelay) -- Chờ 0.8 giây để Server kịp đánh dấu bạn đang có Quest
        
        -- BƯỚC 3: TÌM NPC GIAO HÀNG
        local npc, root
        for i = 1, Config.MaxFindAttempts do
            if not getgenv().AutoFarmDelivery then break end
            
            npc, root = findDeliveryNPC()
            if npc and root then 
                break 
            end
            
            task.wait(Config.FindNPCDelay) -- Quét liên tục 20 lần, mỗi lần cách nhau 0.5s
        end
        
        -- BƯỚC 4: GIAO HÀNG (Nếu tìm thấy)
        if npc and root and getgenv().AutoFarmDelivery then
            teleportTo(root.CFrame * Config.DeliveryOffset)
            task.wait(Config.TeleportDelay) -- Quan trọng: Chờ để Server nhận ra bạn đã đến gần NPC
            
            completeDelivery(npc.Name)
            task.wait(Config.ActionDelay) -- Chờ hoàn thành để tránh lặp ngay lập tức
        else
            -- Nếu lỗi (không tìm thấy NPC do nhận Quest xịt), delay 2s rồi làm lại từ đầu
            task.wait(2)
        end
        
    end
end)
