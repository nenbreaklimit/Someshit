-- ĐÃ TỐI ƯU LẠI CONFIG CHỜ
local Config = {
    StartPos = CFrame.new(-152.8, -21, 668.1),
    DeliveryOffset = CFrame.new(0, -10, 0),
    QuestName = "Fujiwara Bunta",
    
    -- Tách riêng các loại Delay để dễ tinh chỉnh theo mạng của bạn
    TeleportDelay = 1,     -- Thời gian chờ sau khi dịch chuyển (Quan trọng để server nhận diện vị trí)
    ActionDelay = 0.8,     -- Thời gian chờ sau khi bấm nhận/trả quest
    FindNPCDelay = 0.5,    -- Thời gian chờ mỗi lần quét tìm NPC
    MaxFindAttempts = 20   -- Số lần quét tìm NPC tối đa (20 x 0.5s = 10s)
}

