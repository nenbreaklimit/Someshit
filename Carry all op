--// TARGET DETECTOR + STEALTH ESP + BILLBOARD (TEST VERSION)
--// Purely Focused on: Player Name "FaultBee"

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")

local LocalPlayer = Players.LocalPlayer
local TARGET_NAME = "FaultBee" -- Tên người chơi bạn muốn test

--------------------------------------------------
--// CẤU HÌNH HỆ THỐNG (CONFIG)
--------------------------------------------------
local CONFIG = {
    -- Âm thanh & Thông báo
    SoundId = "rbxassetid://9068077052",
    SoundVolume = 2,
    NotificationDuration = 10,
    
    -- Màu sắc ESP & UI
    TargetColor = Color3.fromRGB(255, 50, 50), -- Màu đỏ cảnh báo
    FillTransparency = 1,                       -- 1 = Ẩn hoàn toàn màu thân (chỉ giữ lại viền)
    OutlineTransparency = 0,                    -- 0 = Hiển thị rõ viền ngoài
}

--------------------------------------------------
--// HEURISTICS & CONTAINERS
--------------------------------------------------
local ActiveTrackers = {} 
local CoreContainer = nil

-- Xác định container an toàn nhất cho ESP (Stealth Mode)
if gethui then
    CoreContainer = gethui()
elseif syn and syn.protect_gui then
    CoreContainer = Instance.new("Folder")
    syn.protect_gui(CoreContainer)
    CoreContainer.Parent = game:GetService("CoreGui")
else
    local success, core = pcall(function() return game:GetService("CoreGui") end)
    CoreContainer = success and core or LocalPlayer:WaitForChild("PlayerGui")
end

--------------------------------------------------
--// HELPER FUNCTIONS
--------------------------------------------------
local function PlayAlertSound()
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = CONFIG.SoundId
        sound.Volume = CONFIG.SoundVolume
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Wait()
        sound:Destroy()
    end)
end

local function SendSystemNotice(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = CONFIG.NotificationDuration
        })
    end)
    
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then
            channel:DisplaySystemMessage("<font color='#FF3232'><b>[" .. title .. "]: </b>" .. text .. "</font>")
        end
    end
end

--------------------------------------------------
--// DETECTOR LOGIC (ONLY TARGET NAME)
--------------------------------------------------
local function EvaluatePlayer(player)
    -- Nếu bạn muốn tự test lên chính mình, hãy đổi dòng dưới thành: 
    -- if player.Name == TARGET_NAME then return true, "Test Target" end
    if player == LocalPlayer and player.Name ~= TARGET_NAME then return false, nil end

    if player.Name == TARGET_NAME then
        return true, "Target Found"
    end

    return false, nil
end

--------------------------------------------------
--// STEALTH ESP & BILLBOARD ENGINE
--------------------------------------------------
local function DestroyESP(player)
    if ActiveTrackers[player] then
        for _, item in ipairs(ActiveTrackers[player].Instances or {}) do
            if item then item:Destroy() end
        end
        for _, conn in ipairs(ActiveTrackers[player].Connections or {}) do
            if conn.Connected then conn:Disconnect() end
        end
        ActiveTrackers[player] = nil
    end
end

local function ApplyStealthESP(player, reason)
    DestroyESP(player)

    local tracker = { Instances = {}, Connections = {} }
    ActiveTrackers[player] = tracker

    local function RenderForCharacter(character)
        if not character then return end
        local hrp = character:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end

        -- Highlight ESP (Chỉ hiện viền nhân vật)
        local highlight = Instance.new("Highlight")
        highlight.Name = "TargetESP_" .. player.Name
        highlight.Adornee = character
        highlight.FillColor = CONFIG.TargetColor
        highlight.OutlineColor = CONFIG.TargetColor
        highlight.FillTransparency = CONFIG.FillTransparency
        highlight.OutlineTransparency = CONFIG.OutlineTransparency
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = CoreContainer
        table.insert(tracker.Instances, highlight)

        -- Billboard Tag (Chữ nhỏ gọn trên đầu)
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "TargetTag_" .. player.Name
        billboard.Adornee = hrp
        billboard.Size = UDim2.new(0, 130, 0, 28)
        billboard.StudsOffset = Vector3.new(0, 2.8, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = CoreContainer
        table.insert(tracker.Instances, billboard)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = CONFIG.TargetColor
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 12
        label.Text = string.format("⚠️ TARGET TEST ⚠️\n%s", player.Name)
        label.Parent = billboard
    end

    if player.Character then
        task.spawn(RenderForCharacter, player.Character)
    end

    local charConn = player.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        RenderForCharacter(newChar)
    end)
    table.insert(tracker.Connections, charConn)
end

--------------------------------------------------
--// MONITOR ENGINE
--------------------------------------------------
local function ProcessPlayer(player)
    local function Check()
        local isTarget, reason = EvaluatePlayer(player)
        if isTarget and not ActiveTrackers[player] then
            SendSystemNotice("🎯 TARGET DETECTED", player.Name .. " đã xuất hiện!")
            PlayAlertSound()
            ApplyStealthESP(player, reason)
        end
    end

    -- Quét khi người chơi vừa load
    Check()
    
    -- Dọn dẹp sạch sẽ khi người chơi thoát
    local cleanupConn
    cleanupConn = Players.PlayerRemoving:Connect(function(leavingPlayer)
        if leavingPlayer == player then
            DestroyESP(player)
            if cleanupConn.Connected then cleanupConn:Disconnect() end
        end
    end)
end

--------------------------------------------------
--// MAIN INITIALIZATION
--------------------------------------------------
for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(ProcessPlayer, p)
end

Players.PlayerAdded:Connect(function(p)
    task.spawn(ProcessPlayer, p)
end)

print("⚡ [TEST DETECTOR]: ĐÃ KÍCH HOẠT (ĐANG TÌM: " .. TARGET_NAME .. ")!")
