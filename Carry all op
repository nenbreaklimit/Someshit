\--// TWEEN UTILITY
local function Tween(instance, properties, duration)
    TweenService\:Create(instance, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), properties)\:Play()
end

local function AddButtonEffects(btn, defaultColor, hoverColor)
    btn.MouseEnter\:Connect(function()
        Tween(btn, {BackgroundColor3 = hoverColor})
    end)
    btn.MouseLeave\:Connect(function()
        Tween(btn, {BackgroundColor3 = defaultColor})
    end)
    btn.MouseButton1Down\:Connect(function()
        Tween(btn, {Size = UDim2.new(btn.Size.X.Scale, btn.Size.X.Offset - 4, btn.Size.Y.Scale, btn.Size.Y.Offset - 2)})
    end)
    btn.MouseButton1Up\:Connect(function()
        Tween(btn, {Size = UDim2.new(btn.Size.X.Scale, btn.Size.X.Offset + 4, btn.Size.Y.Scale, btn.Size.Y.Offset + 2)})
    end)
end

