local function PlayAlertSound()
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = CONFIG.SoundId
        sound.Volume = CONFIG.SoundVolume
        sound.Parent = SoundService
        sound\:Play()
        sound.Ended\:Wait()
        sound\:Destroy()
    end)
end

local function SendSystemNotice(title, text)
    pcall(function()
        StarterGui\:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = CONFIG.NotificationDuration
        })
    end)
    
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService.TextChannels\:FindFirstChild("RBXGeneral")
        if channel then
            channel\:DisplaySystemMessage("\<font color='#FF4141'>\<b>[" .. title .. "]: \</b>" .. text .. "\</font>")
        end
    end
end

local function EvaluatePlayer(player)
    if player == LocalPlayer then return false, nil end

    local cmdVal = player\:FindFirstChild("CommandLevel")
    if cmdVal and cmdVal\:IsA("ValueBase") and (tonumber(cmdVal.Value) or 0) > 0 then
        return true, "CommandLevel " .. tostring(cmdVal.Value)
    end
    
    local attrLevel = tonumber(player\:GetAttribute("CommandLevel")) or 0
    if attrLevel > 0 then
        return true, "CommandLevel " .. tostring(attrLevel)
    end

    return false, nil
end

local function DestroyESP(player)
    if ActiveTrackers[player] then
        for \_, item in ipairs(ActiveTrackers[player].Instances or {}) do
            if item then item\:Destroy() end
        end
        for \_, conn in ipairs(ActiveTrackers[player].Connections or {}) do
            if conn.Connected then conn\:Disconnect() end
        end
        ActiveTrackers[player] = nil
    end
end

local function ApplyStealthESP(player, reason)
    DestroyESP(player)

    local tracker = { Instances = {}, Connections = {} }
    ActiveTrackers[player] = tracker

    local function RenderForCharacter(character)
        if not character then return end
        local hrp = character\:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "TargetESP\_" .. player.Name
        highlight.Adornee = character
        highlight.FillColor = CONFIG.TargetColor
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = CONFIG.FillTransparency
        highlight.OutlineTransparency = CONFIG.OutlineTransparency
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = CoreContainer
        table.insert(tracker.Instances, highlight)

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "TargetTag\_" .. player.Name
        billboard.Adornee = hrp
        billboard.Size = UDim2.new(0, 130, 0, 28)
        billboard.StudsOffset = Vector3.new(0, 3.8, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = CoreContainer
        table.insert(tracker.Instances, billboard)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = CONFIG.TargetColor
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.Text = string.format("⚠️ CC / MOD ⚠️\n%s", player.Name)
        label.Parent = billboard
    end

    if player.Character then
        task.spawn(RenderForCharacter, player.Character)
    end

    local charConn = player.CharacterAdded\:Connect(function(newChar)
        task.wait(0.5)
        RenderForCharacter(newChar)
    end)
    table.insert(tracker.Connections, charConn)
end

local function ProcessPlayer(player)
    if player == LocalPlayer then return end

    local function Check()
        local isTarget, reason = EvaluatePlayer(player)
        if isTarget and not ActiveTrackers[player] then
            SendSystemNotice("⚠️ CC/MOD DETECTED", player.Name .. " | " .. reason)
            PlayAlertSound()
            ApplyStealthESP(player, reason)
        end
    end

    Check()

    local childConn = player.ChildAdded\:Connect(function(child)
        if child.Name == "CommandLevel" then
            task.wait(0.1)
            Check()
            local valConn = child\:GetPropertyChangedSignal("Value")\:Connect(Check)
            if ActiveTrackers[player] then table.insert(ActiveTrackers[player].Connections, valConn) end
        end
    end)

    local attrConn = player.AttributeChanged\:Connect(function(attrName)
        if attrName == "CommandLevel" then
            Check()
        end
    end)
    
    local cleanupConn
    cleanupConn = Players.PlayerRemoving\:Connect(function(leavingPlayer)
        if leavingPlayer == player then
            DestroyESP(player)
            if childConn.Connected then childConn\:Disconnect() end
            if attrConn.Connected then attrConn\:Disconnect() end
            if cleanupConn.Connected then cleanupConn\:Disconnect() end
        end
    end)
end

task.spawn(function()
    for \_, p in ipairs(Players\:GetPlayers()) do
        task.spawn(ProcessPlayer, p)
    end
    Players.PlayerAdded\:Connect(function(p)
        task.spawn(ProcessPlayer, p)
    end)
    print("⚡ [CC / MOD DETECTOR]: HỆ THỐNG ĐÃ KÍCH HOẠT!")
end)

