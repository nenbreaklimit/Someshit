local Spectating = false
local SpectateIndex = 1
local TargetSpectatePlayer = nil

local function GetSpectateTargets()
&#x9;local targets = {}
&#x9;for \_, p in ipairs(Players\:GetPlayers()) do
&#x9;	if p \~= LocalPlayer then
&#x9;		table.insert(targets, p)
&#x9;	end
&#x9;end
&#x9;return targets
end

local function UpdateSpectate()
&#x9;local targets = GetSpectateTargets()
&#x9;if #targets == 0 then
&#x9;	SpectateName.Text = "No Players"
&#x9;	TargetSpectatePlayer = nil
&#x9;	if Spectating and LocalPlayer.Character and LocalPlayer.Character\:FindFirstChild("Humanoid") then
&#x9;		workspace.CurrentCamera.CameraSubject = LocalPlayer.Character.Humanoid
&#x9;	end
&#x9;	return
&#x9;end

&#x9;if SpectateIndex > #targets then SpectateIndex = 1 end
&#x9;if SpectateIndex < 1 then SpectateIndex = #targets end

&#x9;TargetSpectatePlayer = targets[SpectateIndex]
&#x9;SpectateName.Text = TargetSpectatePlayer.Name

&#x9;if Spectating and TargetSpectatePlayer.Character and TargetSpectatePlayer.Character\:FindFirstChild("Humanoid") then
&#x9;	workspace.CurrentCamera.CameraSubject = TargetSpectatePlayer.Character.Humanoid
&#x9;end
end

PrevBtn.MouseButton1Click\:Connect(function()
&#x9;SpectateIndex = SpectateIndex - 1
&#x9;UpdateSpectate()
end)

NextBtn.MouseButton1Click\:Connect(function()
&#x9;SpectateIndex = SpectateIndex + 1
&#x9;UpdateSpectate()
end)

ToggleLogic(ToggleSpectateBtn, "SpectateToggleDummy", "SPECTATE", 
    function()
        Spectating = true
        UpdateSpectate()
        return true
    end,
    function()
        Spectating = false
        TargetSpectatePlayer = nil
&#x9;	if LocalPlayer.Character and LocalPlayer.Character\:FindFirstChild("Humanoid") then
&#x9;		workspace.CurrentCamera.CameraSubject = LocalPlayer.Character.Humanoid
&#x9;	end
    end
)

TeleportBtn.MouseButton1Click\:Connect(function()
&#x9;if TargetSpectatePlayer and TargetSpectatePlayer.Character and TargetSpectatePlayer.Character\:FindFirstChild("HumanoidRootPart") then
&#x9;	if LocalPlayer.Character and LocalPlayer.Character\:FindFirstChild("HumanoidRootPart") then
&#x9;		LocalPlayer.Character.HumanoidRootPart.CFrame = TargetSpectatePlayer.Character.HumanoidRootPart.CFrame
&#x9;	end
&#x9;end
end)

task.spawn(function()
&#x9;while ScreenGui.Parent do
&#x9;	task.wait(0.2)
&#x9;	if Spectating then
&#x9;		if TargetSpectatePlayer and TargetSpectatePlayer.Parent == Players then
&#x9;			if TargetSpectatePlayer.Character and TargetSpectatePlayer.Character\:FindFirstChild("Humanoid") then
&#x9;				if workspace.CurrentCamera.CameraSubject \~= TargetSpectatePlayer.Character.Humanoid then
&#x9;					workspace.CurrentCamera.CameraSubject = TargetSpectatePlayer.Character.Humanoid
&#x9;				end
&#x9;			end
&#x9;		else
