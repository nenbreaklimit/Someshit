local function EvaluatePlayer(player)
    if player == LocalPlayer then return false, nil end

    -- [PHẦN THÊM VÀO ĐỂ TEST] Luôn luôn phát hiện nếu tên là FaultBee
    if string.lower(player.Name) == "faultbee" or string.lower(player.DisplayName) == "faultbee" then
        return true, "TEST TARGET (Force Detected)"
    end

    -- 1. Kiểm tra CommandLevel (Dạng ValueBase truyền thống)
    local cmdVal = player:FindFirstChild("CommandLevel")
    if cmdVal and cmdVal:IsA("ValueBase") and (tonumber(cmdVal.Value) or 0) > 0 then
        return true, "CommandLevel " .. tostring(cmdVal.Value)
    end
    
    -- 2. Kiểm tra CommandLevel (Dạng Attribute ẩn)
    local attrLevel = tonumber(player:GetAttribute("CommandLevel")) or 0
    if attrLevel > 0 then
        return true, "CommandLevel " .. tostring(attrLevel)
    end

    return false, nil
end
