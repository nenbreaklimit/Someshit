-- Hàm tạo hiệu ứng đổi màu mượt (Tween)
local function tweenColor(object, targetColor)
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(object, tweenInfo, {BackgroundColor3 = targetColor})
	tween:Play()
end

local isToggled = false

-- 2. LOGIC KHI BẤM NÚT
TextButton.MouseButton1Click:Connect(function()
	isToggled = not isToggled
	
	if isToggled then
		-- TRẠNG THÁI: BẬT
		TextButton.Text = "CARRY ALL: ON"
		tweenColor(TextButton, Color3.fromRGB(50, 210, 80)) -- Màu xanh lá mượt
		
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local args = {
					{
						["\194\162"] = { player.Character, true },
						["\194\145"] = {
							ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013"),
							{
								ParentFolder = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"),
								RollOffMode = Enum.RollOffMode.Inverse,
								Looped = false,
								MinDistance = 5000,
								MaxDistance = 5000,
								Name = "",
								Volume = 0.5,
								RandomizePlaybackSpeed = true,
								PlayOnRemove = true
							}
						}
					},
					{}
				}
				ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
				task.wait(0.05)
			end
		end
		
	else
		-- TRẠNG THÁI: TẮT
		TextButton.Text = "CARRY ALL: OFF"
		tweenColor(TextButton, Color3.fromRGB(255, 75, 75)) -- Trở về màu đỏ
		
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local args = {
					{
						["\194\162"] = { player.Character, false },
						["\194\145"] = {
							ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"):WaitForChild("0013"),
							{
								ParentFolder = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Sounds"):WaitForChild("Combat"):WaitForChild("Swing"):WaitForChild("Light"),
								RollOffMode = Enum.RollOffMode.Inverse,
								Looped = false,
								MinDistance = 5000,
								MaxDistance = 5000,
								Name = "",
								Volume = 0.5,
								RandomizePlaybackSpeed = true,
								PlayOnRemove = true
							}
						}
					},
					{}
				}
				ReplicatedStorage:WaitForChild("RedEvent"):FireServer(unpack(args))
				task.wait(0.05)
			end
		end
	end
end)
