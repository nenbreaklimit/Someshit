--==================================================
-- AUTO FARM DELIVERY - STATE MACHINE & ANTI-DESYNC
--==================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer

getgenv().AutoFarmDelivery = false
task.wait(0.2)
getgenv().AutoFarmDelivery = true

local Config = {
    StartPos = CFrame.new(-152.8, -22, 668.1),
    DeliveryOffset = CFrame.new(0, -10, 0),
    QuestName = "Fujiwara Bunta"
}

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Auto Farm",
        Text = "Đã tối ưu: Tự động dò lỗi và tiếp tục!",
        Duration = 3
    })
end)

--==================================================
-- ANTI-AFK
--==================================================
pcall(function()
    for _, conn in pairs(getconnections(player.Idled)) do
        if conn.Disable then conn:Disable() end
    end
end)

player.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

--==================================================
-- UTILITIES & HOVER LOCK
--==================================================
local function getCharacterData()
    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    return char, root, hum
end

local function teleportTo(targetCFrame)
    local _, root = getCharacterData()
    if root then root.CFrame = targetCFrame end
end

local bodyVel
local function applyFloat()
    local _, root, hum = getCharacterData()
    if not root then return end
    if hum then hum.PlatformStand = true end

    if not root:FindFirstChild("FarmBodyVelocity") then
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.Name = "FarmBodyVelocity"
        bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVel.Velocity = Vector3.zero
        bodyVel.Parent = root
    end
end

local floatConnection
floatConnection = RunService.Heartbeat:Connect(function()
    if not getgenv().AutoFarmDelivery then
        if bodyVel then bodyVel:Destroy() end
        local _, _, hum = getCharacterData()
        if hum then hum.PlatformStand = false end
        if floatConnection then floatConnection:Disconnect() end
        return
    end

    pcall(function()
        applyFloat()
        local _, root = getCharacterData()
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end)

--==================================================
-- CORE LOGIC
--==================================================
local function takeQuest()
    pcall(function()
        local args = { { [";"] = Config.QuestName }, {} }
        ReplicatedStorage:WaitForChild("RedEvent", 3):FireServer(unpack(args))
    end)
end

local function completeDelivery(npcName)
    pcall(function()
        local args = { { ["<"] = npcName }, {} }
        ReplicatedStorage:WaitForChild("RedEvent", 3):FireServer(unpack(args))
    end)
end

local function findDeliveryNPC()
    local foundNpc, foundRoot = nil, nil
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("DeliveryPulse", true) then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if root then
                    foundNpc = obj
                    foundRoot = root
                    break
                end
            end
        end
    end)
    return foundNpc, foundRoot
end

--==================================================
-- MAIN LOOP (TRẠNG THÁI TỰ ĐỘNG DÒ)
--==================================================
task.spawn(function()
    while getgenv().AutoFarmDelivery do
        
        -- 1. Quét xem trên map có NPC giao hàng (tức là đang có nhiệm vụ) hay không
        local npc, root = findDeliveryNPC()

        if npc and root then
            -- TRẠNG THÁI B: Đã có nhiệm vụ -> Tập trung đi giao
            teleportTo(root.CFrame * Config.DeliveryOffset)
            task.wait(0.2) -- Chờ nhân vật load xong vị trí
            
            completeDelivery(npc.Name)
            task.wait(0.4) -- Chờ server xác nhận đã giao xong để xóa NPC đi
        else
            -- TRẠNG THÁI A: Chưa có nhiệm vụ -> Đi lấy nhiệm vụ
            teleportTo(Config.StartPos)
            task.wait(0.2) -- Chờ nhân vật về lại vị trí nhận
            
            takeQuest()
            task.wait(0.6) -- [QUAN TRỌNG] Chờ server xử lý lệnh nhận và spawn NPC giao hàng ra map
        end
        
    end
end)
